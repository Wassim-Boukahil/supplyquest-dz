generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  slug         String        @unique
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  users        User[]
  warehouses   Warehouse[]
  categories   ProductCategory[]
  products     Product[]
  suppliers    Supplier[]
  customers    Customer[]
  inventoryLevels       InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  inventoryTransfers    InventoryTransfer[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String       @unique
  passwordHash   String       @map("password_hash")
  firstName      String       @map("first_name")
  lastName       String       @map("last_name")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  inventoryTransactions InventoryTransaction[]
  inventoryTransfers    InventoryTransfer[]

  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        RoleName   @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Warehouse {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  code           String
  location       String?
  wilaya         String?
  capacity       Int?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryLevels InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders PurchaseOrder[]
  salesOrders SalesOrder[]
  sourceTransfers InventoryTransfer[] @relation("TransferSource")
  destinationTransfers InventoryTransfer[] @relation("TransferDestination")

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("warehouses")
}

model ProductCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("product_categories")
}

model Product {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  categoryId     String?         @map("category_id") @db.Uuid
  preferredSupplierId String?    @map("preferred_supplier_id") @db.Uuid
  sku            String
  name           String
  description    String?
  unit           String
  purchasePrice  Decimal         @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice   Decimal         @map("selling_price") @db.Decimal(12, 2)
  minimumStock   Int             @default(0) @map("minimum_stock")
  safetyStock    Int             @default(0) @map("safety_stock")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  preferredSupplier Supplier?    @relation(fields: [preferredSupplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryLevels InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems SalesOrderItem[]
  transferItems InventoryTransferItem[]

  @@unique([organizationId, sku])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([categoryId])
  @@index([preferredSupplierId])
  @@map("products")
}

model Supplier {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  wilaya         String?
  averageLeadTime Int?        @map("average_lead_time")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  wilaya         String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrders SalesOrder[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("customers")
}

enum RoleName {
  ADMIN
  MANAGER
  PURCHASER
  ANALYST
  OPERATOR
}

enum InventoryTransactionType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  SALE
  CUSTOMER_RETURN
  SUPPLIER_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InventoryTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model InventoryLevel {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  onHandQuantity Int          @default(0) @map("on_hand_quantity")
  reservedQuantity Int        @default(0) @map("reserved_quantity")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, productId, warehouseId])
  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_levels")
}

model InventoryTransaction {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  productId      String                    @map("product_id") @db.Uuid
  warehouseId    String                    @map("warehouse_id") @db.Uuid
  quantity       Int
  type           InventoryTransactionType
  referenceType  String?                   @map("reference_type")
  referenceId    String?                   @map("reference_id") @db.Uuid
  reason         String?
  actorId        String                    @map("actor_id") @db.Uuid
  createdAt      DateTime                  @default(now()) @map("created_at")
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product                   @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  warehouse      Warehouse                 @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor          User                      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([warehouseId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model PurchaseOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  supplierId          String             @map("supplier_id") @db.Uuid
  warehouseId         String             @map("warehouse_id") @db.Uuid
  orderNumber         String             @map("order_number")
  status              PurchaseOrderStatus @default(DRAFT)
  orderDate           DateTime           @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?         @map("expected_delivery_date")
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier            Supplier           @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouse           Warehouse          @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items               PurchaseOrderItem[]

  @@unique([organizationId, orderNumber])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String        @map("product_id") @db.Uuid
  orderedQuantity  Int           @map("ordered_quantity")
  receivedQuantity Int           @default(0) @map("received_quantity")
  purchaseUnitPrice Decimal      @map("purchase_unit_price") @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product         Product       @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

model SalesOrder {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  customerId     String          @map("customer_id") @db.Uuid
  warehouseId    String          @map("warehouse_id") @db.Uuid
  orderNumber    String          @map("order_number")
  status         SalesOrderStatus @default(DRAFT)
  orderDate      DateTime        @default(now()) @map("order_date")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer         @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  warehouse     Warehouse        @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items         SalesOrderItem[]

  @@unique([organizationId, orderNumber])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  salesOrderId   String     @map("sales_order_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  quantity       Int
  sellingUnitPrice Decimal  @map("selling_unit_price") @db.Decimal(12, 2)
  salesOrder     SalesOrder @relation(fields: [salesOrderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product        Product    @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([salesOrderId])
  @@index([productId])
  @@map("sales_order_items")
}

model InventoryTransfer {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  sourceWarehouseId   String                  @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                @map("destination_warehouse_id") @db.Uuid
  status              InventoryTransferStatus  @default(PENDING)
  actorId             String                  @map("actor_id") @db.Uuid
  notes               String?
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceWarehouse     Warehouse               @relation("TransferSource", fields: [sourceWarehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  destinationWarehouse Warehouse              @relation("TransferDestination", fields: [destinationWarehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor               User                    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  items               InventoryTransferItem[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  transferId     String            @map("transfer_id") @db.Uuid
  productId      String            @map("product_id") @db.Uuid
  quantity       Int
  transfer       InventoryTransfer @relation(fields: [transferId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product        Product           @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([transferId])
  @@index([productId])
  @@map("inventory_transfer_items")
}