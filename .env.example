# Replit provides DATABASE_URL automatically for the managed PostgreSQL database.
DATABASE_URL="postgresql://user:password@localhost:5432/supplyquest"

# Set a strong value in Replit Secrets for non-demo environments.
# The app also accepts the existing SESSION_SECRET as a local fallback.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="2h"
PORT="5000"
NODE_ENV="development"